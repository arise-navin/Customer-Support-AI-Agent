# ==============================================================================
# Signet Customer Support AI Agent Lab - Environment Configuration Template
# ==============================================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Neon or Local)
DATABASE_URL="postgresql://user:password@localhost:5432/customer_support_db?sslmode=prefer"

# Internal JWT / Session Secret
API_SECRET_KEY=dev-secret-key-signet-support-lab-2026

# Ollama Configuration
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=beam:cloud
OLLAMA_TIMEOUT_MS=120000
OLLAMA_API_KEY=your_ollama_api_key_here

# AI Execution Mode: 'DIRECT_OLLAMA' | 'SIGNET_MOCK' | 'SIGNET_REAL' | 'SIGNET_HYBRID_EDGE'
AI_EXECUTION_MODE=DIRECT_OLLAMA

# Signet Gateway (For SIGNET_REAL Mode)
SIGNET_GATEWAY_URL=http://localhost:8080
SIGNET_TENANT_ID=tenant-support-lab-01
SIGNET_ENFORCEMENT_REQUIRED=true

# Signet Hybrid Edge (MID Server Style)
SIGNET_HYBRID_EDGE_ENABLED=true
SIGNET_HYBRID_SAAS_URL=https://cloud.signet.techsnitch.com
SIGNET_HYBRID_HEARTBEAT_SEC=15
