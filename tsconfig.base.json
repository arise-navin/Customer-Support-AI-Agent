{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@signet/database": ["packages/database/src/index.ts"],
      "@signet/shared": ["packages/shared/src/index.ts"],
      "@signet/agents": ["packages/agents/src/index.ts"],
      "@signet/tools": ["packages/tools/src/index.ts"],
      "@signet/signet-adapter": ["packages/signet-adapter/src/index.ts"]
    }
  }
}
