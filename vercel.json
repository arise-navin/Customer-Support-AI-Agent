{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "apps/backend",
      "framework": "fastify",
      "entrypoint": "src/index.ts",
      "functions": { "src/index.ts": { "includeFiles": "{package.json,../../package.json}" } },
      "buildCommand": "prisma generate --schema=../../prisma/schema.prisma"
    },
    "frontend": {
      "root": "apps/frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
